# Committed template. Names and placeholders ONLY — never real values.
# Copy to .env.local for development. Real values live in the platform's encrypted
# environment store for preview and production, marked sensitive.

# --- Public: inlined into the browser bundle at build time. Never a secret here. ---
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Publishable/anon key. Safe on the client; its safety rests on RLS, not on secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_or_anon_key_here"

# --- Server-only. Never prefix with NEXT_PUBLIC_. Never commit a real value. ---
# Bypasses row-level security. Required only for administrative operations that
# genuinely cannot be expressed as a policy.
SUPABASE_SECRET_KEY="sb_secret_key_here"

# --- SMS provider (FR-1 phone OTP) -------------------------------------------
# Configured in supabase/config.toml for local development, and in the Supabase
# dashboard or self-hosted auth environment for deployed instances. Listed here so
# the requirement is visible; the app itself never reads these.
# SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=""
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=""
# SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=""

# --- Stellar (M4 Vault; not used in M1) --------------------------------------
# The Vault is blocked on the legal opinion in PRD Q6. No key belongs here: a user's
# wallet key never touches this application, and a server-side signer, if one is ever
# needed, belongs in a KMS or HSM rather than an environment variable.
# NEXT_PUBLIC_STELLAR_NETWORK="testnet"
